<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="DX Data Sharing">
    <f:entry title="DX Token Credential" field="dxTokenCredentialId">
      <f:credentialsSelect class="org.jenkinsci.plugins.plaincredentials.StringCredentials"/>
    </f:entry>
    <f:entry title="DX API Base Path" field="dxPath">
      <f:textbox/>
    </f:entry>
    <f:entry title="Proxy Host" field="proxyHost">
      <f:textbox/>
    </f:entry>
    <f:entry title="Proxy Port" field="proxyPort">
      <f:number/>
    </f:entry>
    <f:entry title="Debug Logging" field="debugLogging">
      <f:checkbox/>
    </f:entry>
    <f:entry title="Include Repository (regex)" field="includeRepoPattern">
      <f:textbox/>
    </f:entry>
    <f:entry title="Exclude Repository (regex)" field="excludeRepoPattern">
      <f:textbox/>
    </f:entry>
    <f:entry title="Include Job (regex)" field="includeJobPattern">
      <f:textbox/>
    </f:entry>
    <f:entry title="Exclude Job (regex)" field="excludeJobPattern">
      <f:textbox/>
    </f:entry>
    <f:entry title="Include Branch (regex)" field="includeBranchPattern">
      <f:textbox/>
    </f:entry>
    <f:entry title="Exclude Branch (regex)" field="excludeBranchPattern">
      <f:textbox/>
    </f:entry>
  </f:section>
</j:jelly>

